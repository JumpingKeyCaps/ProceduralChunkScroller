uniform float2 iResolution;
uniform float4 iWallColor;
uniform float4 iVoidColor;
uniform float iEdgePoints[10];
uniform float iHatchDensity;
uniform float iDisplacementStrength;
uniform float iScaleMultiplier;
uniform float iAngularity;    // 0.0 (Euclidien rond) -> 1.0 (Manhattan/Chebyshev anguleux)
uniform float iStrataStretch; // Étirement anisotrope X/Y
uniform float iTectonicWarp;  // Intensité de la torsion spatiale

// Hachage 2D -> 2D
float2 hash2(float2 p) {
    p = float2(dot(p, float2(127.1, 311.7)), dot(p, float2(269.5, 183.3)));
    return fract(sin(p) * 43758.5453123);
}

// Interpolation linéaire de la courbe guide
float getGuideEdgeX(float y) {
    if (y <= iEdgePoints[3]) {
        float t = clamp((y - iEdgePoints[1]) / (iEdgePoints[3] - iEdgePoints[1]), 0.0, 1.0);
        return mix(iEdgePoints[0], iEdgePoints[2], t);
    } else if (y <= iEdgePoints[5]) {
        float t = clamp((y - iEdgePoints[3]) / (iEdgePoints[5] - iEdgePoints[3]), 0.0, 1.0);
        return mix(iEdgePoints[2], iEdgePoints[4], t);
    } else if (y <= iEdgePoints[7]) {
        float t = clamp((y - iEdgePoints[5]) / (iEdgePoints[7] - iEdgePoints[5]), 0.0, 1.0);
        return mix(iEdgePoints[4], iEdgePoints[6], t);
    } else {
        float t = clamp((y - iEdgePoints[7]) / (iEdgePoints[9] - iEdgePoints[7]), 0.0, 1.0);
        return mix(iEdgePoints[6], iEdgePoints[8], t);
    }
}

// Distance hybride : permet de passer de blocs arrondis à des blocs géométriques/cristallins
float customMetric(float2 r, float angularity) {
    float euclid = dot(r, r);
    // Combinaison Manhattan + Chebyshev pour des arêtes vives et facettées
    float manhattan = abs(r.x) + abs(r.y);
    float chebyshev = max(abs(r.x), abs(r.y));
    float sharp = mix(manhattan * 0.7, chebyshev, 0.5);
    return mix(euclid, sharp * sharp, angularity);
}

// Voronoi avec métrique morphologique variable
float voronoiHeight(float2 x, float angularity) {
    float2 n = floor(x);
    float2 f = fract(x);

    float md = 8.0;
    float2 mr = float2(0.0);
    float2 mg = float2(0.0);

    for (int j=-1; j<=1; j++) {
        for (int i=-1; i<=1; i++) {
            float2 g = float2(float(i), float(j));
            float2 o = hash2(n + g);
            o = 0.5 + 0.5 * sin(6.2831 * o);

            float2 r = g + o - f;
            float d = customMetric(r, angularity);

            if (d < md) {
                md = d;
                mr = r;
                mg = g;
            }
        }
    }

    // Second passage pour les arêtes de fracture
    md = 8.0;
    for (int j=-2; j<=2; j++) {
        for (int i=-2; i<=2; i++) {
            float2 g = mg + float2(float(i), float(j));
            float2 o = hash2(n + g);
            o = 0.5 + 0.5 * sin(6.2831 * o);

            float2 r = g + o - f;

            if (dot(mr-r, mr-r) > 0.00001) {
                // On module aussi le calcul de frontière selon l'angularité
                float edgeEuclid = dot(0.5*(mr+r), normalize(r-mr));
                float2 diff = abs(r - mr);
                float edgeSharp = max(diff.x, diff.y) * 0.5;
                float edgeDist = mix(edgeEuclid, edgeSharp, angularity * 0.65);
                md = min(md, edgeDist);
            }
        }
    }
    return md;
}

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspect = iResolution.x / iResolution.y;

    float guideX = getGuideEdgeX(uv.y);
    float distFromGuide = uv.x - guideX;

    // Espace de base (non déformé pour que les hachures restent propres et rectilignes)
    float2 baseSpace = float2(distFromGuide * aspect, uv.y) * iScaleMultiplier;

    // --- DÉFORMATION MORPHOLOGIQUE DE L'ESPACE DES BLOCS ---
    // 1. Étirement des strates (anisotropie)
    float2 rockSpace = float2(baseSpace.x / iStrataStretch, baseSpace.y * iStrataStretch);

    // 2. Domain Warping (torsion tectonique progressive)
    if (iTectonicWarp > 0.001) {
        float2 warpOffset = float2(
            sin(rockSpace.y * 5.0 + rockSpace.x * 2.0),
            cos(rockSpace.x * 4.5 - rockSpace.y * 2.5)
        ) * 0.18 * iTectonicWarp;
        rockSpace += warpOffset;
    }

    // --- ACCUMULATION DE HAUTEURS ---
    float hMacro = voronoiHeight(rockSpace * float2(3.0, 7.0), iAngularity);
    float hMeso  = voronoiHeight(rockSpace * float2(8.0, 18.0), iAngularity);
    float hMicro = voronoiHeight(rockSpace * float2(22.0, 48.0), iAngularity * 0.5);

    float combinedHeight = hMacro * 0.55 + hMeso * 0.30 + hMicro * 0.15;
    float rockShape = smoothstep(0.02, 0.25, combinedHeight);

    // Sculpture du bord
    float organicDisplacement = (rockShape - 0.5) * iDisplacementStrength;
    float trueSurfaceDist = distFromGuide - organicDisplacement;

    if (trueSurfaceDist > 0.0) {
        return half4(iVoidColor);
    }

    // --- STYLE GRAVURE : HACHURES NON DÉFORMÉES ---
    // On utilise baseSpace pour garder des traits de burin bien droits et réguliers
    float2 hDir = normalize(float2(1.0, 1.0));
    float2 hDirCross = normalize(float2(-1.0, 1.0));

    float hatch1 = step(0.6, fract(dot(baseSpace * iHatchDensity, hDir)));
    float hatch2 = step(0.6, fract(dot(baseSpace * iHatchDensity, hDirCross)));
    float hatchLight = step(0.75, fract(dot(baseSpace * (iHatchDensity * 0.615), hDir)));

    float shading = mix(0.1, 1.0, rockShape);

    if (rockShape < 0.35) {
        float cross = hatch1 * hatch2;
        shading *= mix(0.05, 0.3, cross);
    } else if (rockShape < 0.65) {
        float mixedHatch = mix(hatch1, hatch1 * hatch2, 0.4);
        shading *= mix(0.25, 0.65, mixedHatch);
    } else if (rockShape < 0.85) {
        shading *= mix(0.4, 0.8, hatch1);
    } else {
        shading *= mix(0.75, 0.95, hatchLight);
    }

    float depthShadow = smoothstep(0.0, 0.45, abs(trueSurfaceDist));
    shading *= mix(0.15, 1.0, depthShadow);

    float edgeShadow = smoothstep(0.0, 0.02, abs(trueSurfaceDist));
    shading *= mix(0.3, 1.0, edgeShadow);

    return half4(iWallColor.rgb * shading, 1.0);
}